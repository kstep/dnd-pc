OPENAI_API_KEY=sk-...
FIREBASE_PROJECT_ID=dnd-pc-d6388
# Public Firebase Web API key — same value as in index.html.
# Used for unauthenticated Firestore reads of shared characters.
FIREBASE_API_KEY=AIza...
ALLOWED_ORIGINS=http://localhost:3000
RUST_LOG=info

# Read by the frontend build (option_env!) — must match the backend's
# listening address when developing locally. Set it when running trunk:
#   set -a; source backend/.env; set +a
#   trunk serve --port 3000 --open
PROXY_URL=http://localhost:8080
